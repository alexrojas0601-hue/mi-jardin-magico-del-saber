{
  // Cloudflare despliega este Worker desde GitHub (rama main).
  "name": "mi-jardin-magico-del-saber",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODELO": "claude-haiku-5-5"
  }
  // Secreto (no va en el repositorio): ANTHROPIC_API_KEY, se agrega en Cloudflare
  // → Workers & Pages → mi-jardin-magico-del-saber → Settings → Variables and Secrets.
}
